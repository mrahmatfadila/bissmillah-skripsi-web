  + id
}

entity "Ticket" as ticket {
  + id
  --
  # creatorId (FK)
  # assigneeId (FK, Nullable)
  # kbArticleId (FK, Nullable)
}

entity "Comment" as comment {
  + id
  --
  # ticketId (FK)
  # authorId (FK)
}

entity "KnowledgeBase" as kb {
  + id
  --
  # authorId (FK)
}

entity "Notification" as notif {
  + id
  --
  # userId (FK)
  # ticketId (FK, Nullable)
}

user ||--o{ ticket : " User ID jadi FK di Ticket (creatorId)"
user |o--o{ ticket : " User ID jadi FK di Ticket (assigneeId)"
user ||--o{ comment : " User ID jadi FK di Comment"
user ||--o{ kb : " User ID jadi FK di KB"
user ||--o{ notif : " User ID jadi FK di Notif"

ticket ||--o{ comment : " Ticket ID jadi FK di Comment"
ticket |o--o{ notif : " Ticket ID jadi FK di Notif"

kb |o--o{ ticket : " KB ID jadi FK di Ticket"
@enduml

@startuml LRS
' Copy dari @startuml LRS sampai @enduml ini saja untuk diagram 3
hide circle
skinparam linetype ortho

entity "User" as user {
  + id : String [PK]
  --
  nik : String?
  name : String?
  email : String?
  password : String
  role : Enum
  department : String?
  location : String?
  createdAt : DateTime
  updatedAt : DateTime
  image : String?
  failedLoginAttempts : Int
  lockedUntil : DateTime?
}

entity "Ticket" as ticket {
  + id : String [PK]
  --
  ticketNumber : String
  title : String
  description : String
  status : Enum
  priority : Enum
  category : String?
  ahpScore : Float?
  createdAt : DateTime
  updatedAt : DateTime
  # creatorId : String [FK]
  # assigneeId : String? [FK]
  # kbArticleId : String? [FK]
  attachments : String[]
}

entity "Comment" as comment {
  + id : String [PK]
  --
  content : String
  createdAt : DateTime
  # ticketId : String [FK]
  # authorId : String [FK]
  attachments : String[]
}

entity "KnowledgeBase" as kb {
  + id : String [PK]
  --
  title : String
  content : String
  category : String
  tags : String?
  createdAt : DateTime
  updatedAt : DateTime
  # authorId : String [FK]
}

entity "Notification" as notif {
  + id : String [PK]
  --
  title : String
  message : String
  type : String
  read : Boolean
  link : String?
  createdAt : DateTime
  # userId : String [FK]
  # ticketId : String? [FK]
}

entity "AHPCriteria" as ahp {
  + id : String [PK]
  --
  name : String
  weight : Float
  description : String?
  createdAt : DateTime
  updatedAt : DateTime
}

entity "ShiftSchedule" as schedule {
  + id : String [PK]
  --
  date : DateTime
  shift : String
  agentName : String
  createdAt : DateTime
  updatedAt : DateTime
}

entity "ShiftSwapRequest" as swap {
  + id : String [PK]
  --
  requesterName : String
  requesterShift : String
  requesterDate : DateTime
  targetName : String
  targetShift : String
  targetDate : DateTime
  reason : String?
  status : String
  approvedBy : String?
  approvedAt : DateTime?
  createdAt : DateTime
  updatedAt : DateTime
}

user ||..o{ ticket : " creatorId"
user |o..o{ ticket : " assigneeId"
user ||..o{ comment : " authorId"
user ||..o{ kb : " authorId"
user ||..o{ notif : " userId"

ticket ||..o{ comment : " ticketId"
ticket |o..o{ notif : " ticketId"

kb |o..o{ ticket : " kbArticleId"
@enduml
