hide circle
skinparam linetype ortho

entity "User" as user
entity "Ticket" as ticket
entity "Comment" as comment
entity "KnowledgeBase" as kb
entity "Notification" as notif

user ||--o{ ticket : "membuat"
user |o--o{ ticket : "ditugaskan pada"
user ||--o{ comment : "menulis"
user ||--o{ kb : "menyusun"
user ||--o{ notif : "menerima"

ticket ||--o{ comment : "memiliki"
ticket |o--o{ notif : "memicu"

kb |o--o{ ticket : "direferensikan di"
@enduml

